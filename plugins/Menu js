// ==================== HANDLE MENU COMMAND ====================
async function handleMenuCommand(socket, sender, args, prefix, pushName) {
    const subCommand = args[0] ? args[0].toLowerCase() : 'main';
    
    let menuText = '';
    let menuType = 'image';
    
    switch (subCommand) {
        case 'ai':
            menuText = getAIMenu(prefix);
            menuType = 'text';
            break;
        case 'audio':
            menuText = getAudioMenu(prefix);
            menuType = 'text';
            break;
        case 'download':
            menuText = getDownloadMenu(prefix);
            menuType = 'text';
            break;
        case 'ephoto':
        case 'ephoto360':
            menuText = getEphotoMenu(prefix);
            menuType = 'text';
            break;
        case 'fun':
            menuText = getFunMenu(prefix);
            menuType = 'text';
            break;
        case 'games':
            menuText = getGamesMenu(prefix);
            menuType = 'text';
            break;
        case 'group':
            menuText = getGroupMenu(prefix);
            menuType = 'text';
            break;
        case 'groupstatus':
            menuText = getGroupStatusMenu(prefix);
            menuType = 'text';
            break;
        case 'image':
            menuText = getImageMenu(prefix);
            menuType = 'text';
            break;
        case 'other':
            menuText = getOtherMenu(prefix);
            menuType = 'text';
            break;
        case 'owner':
            menuText = getOwnerMenu(prefix);
            menuType = 'text';
            break;
        case 'religion':
            menuText = getReligionMenu(prefix);
            menuType = 'text';
            break;
        case 'search':
            menuText = getSearchMenu(prefix);
            menuType = 'text';
            break;
        case 'settings':
            menuText = getSettingsMenu(prefix);
            menuType = 'text';
            break;
        case 'sports':
            menuText = getSportsMenu(prefix);
            menuType = 'text';
            break;
        case 'support':
            menuText = getSupportMenu(prefix);
            menuType = 'text';
            break;
        case 'tools':
            menuText = getToolsMenu(prefix);
            menuType = 'text';
            break;
        case 'translate':
            menuText = getTranslateMenu(prefix);
            menuType = 'text';
            break;
        case 'video':
            menuText = getVideoMenu(prefix);
            menuType = 'text';
            break;
        case 'channel':
        case 'viewchannel':
            menuText = getViewChannelMenu(prefix);
            menuType = 'text';
            break;
        default:
            menuText = getMainMenu(prefix, pushName);
            menuType = 'image';
    }
    
    if (menuType === 'image') {
        await socket.sendMessage(sender, { 
            image: { url: botLogo }, 
            caption: menuText 
        });
    } else {
        await socket.sendMessage(sender, { text: menuText });
    }
}

