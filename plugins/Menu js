// Function to handle menu command
async function handleMenuCommand(socket, sender, args, prefix, pushName) {
    const subCommand = args[0] ? args[0].toLowerCase() : 'main';
    
    let menuText = '';
    
    switch (subCommand) {
        case 'ai':
            menuText = getAIMenu(prefix);
            break;
        case 'audio':
            menuText = getAudioMenu(prefix);
            break;
        case 'download':
            menuText = getDownloadMenu(prefix);
            break;
        case 'group':
            menuText = getGroupMenu(prefix);
            break;
        case 'owner':
            menuText = getOwnerMenu(prefix);
            break;
        case 'settings':
            menuText = getSettingsMenu(prefix);
            break;
        case 'tools':
            menuText = getToolsMenu(prefix);
            break;
        default:
            menuText = getMainMenu(prefix, pushName);
    }
    
    await socket.sendMessage(sender, { 
        image: { url: botLogo }, 
        caption: menuText 
    });
}

